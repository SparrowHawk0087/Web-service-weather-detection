# Local Docker Compose configuration.
# Copy this file to .env and replace both placeholders before starting.

DB_USER=weather
DB_PASSWORD=replace-with-a-random-password
DB_NAME=web_service_weather_detection_development
DB_NAME_TEST=web_service_weather_detection_test

SECRET_KEY_BASE=replace-with-openssl-rand-hex-64

# Comma-separated list of browser origins allowed to call Rails.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Sidekiq Web UI credentials. The UI is mounted at /sidekiq
# and denies every request until both values are configured.
SIDEKIQ_WEB_USERNAME=
SIDEKIQ_WEB_PASSWORD=

# Optional mock ML behavior.
MOCK_SCENARIO=random
MOCK_DELAY_SECONDS=1
MOCK_FAIL_FIRST_N_REQUESTS=0
