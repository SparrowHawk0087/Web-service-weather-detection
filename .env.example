# Optional local Docker Compose overrides.
# docker compose up --build also works without creating this file.
# These values are for local development only. Use strong unique secrets in production.

DB_USER=weather
DB_PASSWORD=weather_dev_password
DB_NAME=web_service_weather_detection_development
DB_NAME_TEST=web_service_weather_detection_test

SECRET_KEY_BASE=weather-detection-local-dev-secret-key-base-change-before-deployment-2026

# Comma-separated list of browser origins allowed to call Rails.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Sidekiq Web UI credentials. The UI denies every request
# until both values are configured.
SIDEKIQ_WEB_USERNAME=
SIDEKIQ_WEB_PASSWORD=

# Optional mock ML behavior.
MOCK_SCENARIO=random
MOCK_DELAY_SECONDS=1
MOCK_FAIL_FIRST_N_REQUESTS=0
