# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore key files for decrypting credentials and more.
/config/*.key

# Ignore bundler gems installed locally.
vendor/bundle

# Rails credentials
/config/credentials/*.key
/config/master.key
/config/credentials/local.*
/config/*.local.yml
/config/settings/*.local.yml

# Compiled assets (sprockets / propshaft / vite / jsbundling)
/public/assets/
/public/packs/
/public/packs-test/
/public/vite/
/public/vite-dev/
/public/vite-test/
/app/assets/builds/*
!/app/assets/builds/.keep

# node_modules — if frontend is built inside backend-api
/node_modules
/yarn-error.log
/npm-debug.log*
/.yarn/

# Linters and test caches
/.rubocop_cache
/.rspec_status
/coverage/
/tmp/cache/*
!/tmp/cache/.keep

# Docker (if using compose with override)
/docker-compose.override.yml

# PostgreSQL — local artifacts
/db/*.dump
/db/*.sql
/db/*.backup
/db/*.tar
/.pgdata/
/.postgres/
pgdata/
.pgpass
*.pgpass
.psql_history
.psqlrc.local

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp